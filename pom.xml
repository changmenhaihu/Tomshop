<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      TomShop - 前后端分离 B2C 电商单体后端

      编译约定：
        * 本机无 JDK 17，使用 G:/develop/jdk (Temurin 21) 编译，通过 maven.compiler.release=17
          产出 Java 17 字节码，严格贴合技术栈约束。
        * 命令行构建请显式指定 JAVA_HOME=G:/develop/jdk，避免误用 PATH 上的 JDK 18。

      本地仓库：G:/maven-repo（配置于 G:/develop/apache-maven-3.9.16/conf/settings.xml）

      依赖引入策略：按阶段增量引入。阶段 0 仅引入 Web / 校验 / 持久层 / Redis / 工具链 / 文档，
      Sa-Token(阶段3)、Redisson + Caffeine(阶段4)、Netty + RocketMQ(阶段5) 届时再追加，
      以保证每个阶段结束时项目都能独立启动、独立验证。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.tom</groupId>
    <artifactId>tomshop</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>tomshop</name>
    <description>TomShop 前后端分离 B2C 电商单体后端</description>

    <properties>
        <!-- ========== 编译 ========== -->
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- ========== 第三方依赖版本 ========== -->
        <mybatis-plus.version>3.5.9</mybatis-plus.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <knife4j.version>4.5.0</knife4j.version>
        <!--
          knife4j 4.5.0 传递依赖 springdoc-openapi 2.3.0，该版本面向 Spring Boot 3.2，
          与 Spring Boot 3.3.x（Spring Framework 6.1.x）搭配存在 NoSuchMethodError 风险。
          此处显式提升到 2.6.0（最近优先原则生效），避免阶段 0 就卡在文档页 404 / 启动报错。
        -->
        <springdoc.version>2.3.0</springdoc.version>
        <commons-collections4.version>4.4</commons-collections4.version>
        <commons-io.version>2.16.1</commons-io.version>
        <!-- 阶段 3：安全框架。用户明确用 Sa-Token 替代原始需求中的 Shiro -->
        <sa-token.version>1.46.0</sa-token.version>
        <!--
          阶段 4：多级缓存。
          Caffeine 2.9.3 / Redisson 3.31.0 是本机离线仓库中可用的版本（无外网）。
          Caffeine 3.x 需要 Java 11+，本项目与 2.9.x 的 API 用法一致；
          Redisson 3.31.0 与 3.34.x 在锁/限流 API 上无差异。联网后可平滑升级。
        -->
        <caffeine.version>2.9.3</caffeine.version>
        <redisson.version>3.31.0</redisson.version>
        <!--
          离线仓库里 netty-resolver-dns 只到 4.1.113，而 Boot 3.3.5 管理的默认版本是 4.1.114。
          显式对齐到 4.1.113（该版本下本模块所需 artifact 齐全），联网后可删除本属性。
        -->
        <netty.version>4.1.113.Final</netty.version>
        <!-- redisson 3.31.0 的父 POM 声明 rxjava 3.1.9，本地只有 3.1.8；直接声明以覆盖传递版本 -->
        <rxjava.version>3.1.8</rxjava.version>
    </properties>

    <dependencies>
        <!-- ==================== Web / 参数校验 / AOP / 探活 ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ==================== 持久层：MyBatis-Plus + MySQL ==================== -->
        <!-- 必须是 spring-boot3 专用 starter，普通版基于 javax.* 在 Spring Boot 3 下无法装配 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!--
          自 MyBatis-Plus 3.5.9 起，jsqlparser 被移出核心包改为可选依赖，
          PaginationInnerInterceptor（分页）与 BlockAttackInnerInterceptor（防全表更新）
          随之迁到本适配包中，不引则编译期直接「找不到符号」。
          OptimisticLockerInnerInterceptor 不依赖 SQL 解析，仍留在核心包内。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ==================== 缓存：Redis（Lettuce + 连接池） ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- ==================== 多级缓存：Caffeine L1 + Redisson 分布式锁（阶段 4） ==================== -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>${caffeine.version}</version>
        </dependency>
        <!--
          只引 redisson 核心包，不引 redisson-spring-boot-starter：
          后者会用 Redisson 顶替 Boot 自动装配的 Lettuce 连接工厂，并把 Spring Data Redis
          的序列化配置换成自己的一套，与现有 RedisConfig / Sa-Token 的 StringRedisTemplate 产生隐性耦合。
          本项目只需要 RedissonClient 做分布式锁，连接配置自行构建更可控。
        -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
            <version>${redisson.version}</version>
            <exclusions>
                <!-- rxjava 3.1.9 不在本地仓库；改为下面显式声明的 3.1.8，避免离线解析时告警 -->
                <exclusion>
                    <groupId>io.reactivex.rxjava3</groupId>
                    <artifactId>rxjava</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!--
          redisson 的 netty 依赖声明为 provided（不传递），运行期必须自带。
          版本交给 spring-boot-dependencies 管理（与 Boot 3.3.5 对齐），不手写版本号。
        -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-handler</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-resolver-dns</artifactId>
        </dependency>
        <!-- redisson 的响应式 API 依赖 rxjava3；锁功能本身不用，但类加载期需要它在 classpath -->
        <dependency>
            <groupId>io.reactivex.rxjava3</groupId>
            <artifactId>rxjava</artifactId>
            <version>${rxjava.version}</version>
        </dependency>

        <!-- ==================== 安全：Sa-Token（阶段 3） ==================== -->
        <!--
          为什么是 sa-token-spring-boot3-starter 而不是普通 starter：
          普通版基于 javax.servlet，在 Spring Boot 3（jakarta.*）下拦截器无法装配。
        -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
        <!--
          会话存储切到 Redis：Sa-Token 默认把登录态放在 JVM 内存，多实例部署时
          A 机登录、B 机校验会直接判未登录。改用 Redis 后登录态可跨实例共享，
          并且服务重启不会把在线用户集体踢下线。
        -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-jackson</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
        <!--
          JWT 支持：把 access token 签发成 JWT（token-style=jwt + StpLogicJwtForSimple）。
          与之配套的短时 access + 长时 refresh 双令牌方案见 AuthServiceImpl。
        -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-jwt</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
        <!--
          仅取 BCryptPasswordEncoder，不引入 spring-boot-starter-security ——
          后者会接管全部请求并塞进一整套过滤器链，与 Sa-Token 的拦截器方案冲突。
          本包是纯粹的加密工具库，无自动装配。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- ==================== 工具链 ==================== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-collections4</artifactId>
            <version>${commons-collections4.version}</version>
        </dependency>
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>${commons-io.version}</version>
        </dependency>

        <!-- ==================== 接口文档：Knife4j（OpenAPI 3 + Jakarta） ==================== -->
        <!-- SpringDoc OpenAPI3 核心依赖（SpringBoot3专用） -->
<dependency>
    <groupId>org.springdoc</groupId>
    <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    <version>2.3.0</version>
</dependency>
<!-- Knife4j 4.x适配SpringBoot3 -->
<dependency>
    <groupId>com.github.xiaoymin</groupId>
    <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
    <version>4.5.0</version>
</dependency>

        <!-- ==================== 测试 ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              显式声明注解处理器路径与顺序：lombok -> mapstruct-processor -> lombok-mapstruct-binding。
              三者缺一或顺序错乱，会出现「MapStruct 生成空实现」或「找不到 getter/setter」的诡异问题。
              lombok-mapstruct-binding 仅作处理器使用，不作为普通依赖引入。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
